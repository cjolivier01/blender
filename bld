#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${CONDA_PREFIX:-}" ]]; then
  echo "CONDA_PREFIX is not set. Activate your conda env first."
  exit 1
fi

python_executable="${CONDA_PREFIX}/bin/python"
if [[ ! -x "${python_executable}" ]]; then
  echo "Python is not executable: ${python_executable}"
  exit 1
fi

py_info="$(
  "${python_executable}" - <<'PY'
import os
import sys
import pathlib
import sysconfig
import shlex

try:
  import numpy as np
except Exception as ex:
  print(f"ERROR: NumPy import failed: {ex}")
  raise SystemExit(2)

python_root = pathlib.Path(sys.prefix).resolve()
conda_root = pathlib.Path(os.environ["CONDA_PREFIX"]).resolve()
if python_root != conda_root:
  print(f"ERROR: {sys.executable} uses prefix {python_root}, expected {conda_root}")
  raise SystemExit(2)

major_minor = f"{sys.version_info.major}.{sys.version_info.minor}"
include_dir = pathlib.Path(sysconfig.get_path("include"))
include_config_dir = pathlib.Path(sysconfig.get_path("platinclude") or include_dir)
libdir = pathlib.Path(sysconfig.get_config_var("LIBDIR") or (sys.prefix + "/lib"))
ldlibrary = sysconfig.get_config_var("LDLIBRARY") or ""
if not ldlibrary:
  ldlibrary = f"libpython{major_minor}.so"

python_library = pathlib.Path(ldlibrary)
if not python_library.is_absolute():
  python_library = libdir / python_library
if not python_library.exists():
  fallback = libdir / f"libpython{major_minor}.so"
  if fallback.exists():
    python_library = fallback

numpy_include = pathlib.Path(np.get_include())
numpy_site = pathlib.Path(np.__file__).resolve().parents[1]
numpy_libs = numpy_site / "numpy.libs"

for label, path in (
    ("Python include directory", include_dir),
    ("Python configuration include directory", include_config_dir),
    ("Python library directory", libdir),
    ("Python library", python_library),
    ("NumPy include directory", numpy_include),
):
  if not path.exists():
    print(f"ERROR: {label} does not exist: {path}")
    raise SystemExit(2)

def emit(name: str, value: object) -> None:
  print(f"{name}={shlex.quote(str(value))}")

emit("PYTHON_VERSION", major_minor)
emit("PYTHON_ROOT_DIR", python_root)
emit("PYTHON_EXECUTABLE", pathlib.Path(sys.executable).resolve())
emit("PYTHON_INCLUDE_DIR", include_dir)
emit("PYTHON_INCLUDE_CONFIG_DIR", include_config_dir)
emit("PYTHON_LIBPATH", libdir)
emit("PYTHON_LIBRARY", python_library)
emit("PYTHON_NUMPY_PATH", numpy_site)
emit("PYTHON_NUMPY_INCLUDE_DIRS", numpy_include)
emit("PYTHON_NUMPY_LIBS", numpy_libs)
PY
)"

eval "$py_info"

build_cmake_args=(
  "-DPYTHON_VERSION=${PYTHON_VERSION}"
  "-DPYTHON_ROOT_DIR=${PYTHON_ROOT_DIR}"
  "-DPYTHON_EXECUTABLE=${PYTHON_EXECUTABLE}"
  "-DPYTHON_LIBPATH=${PYTHON_LIBPATH}"
  "-DPYTHON_LIBRARY=${PYTHON_LIBRARY}"
  "-DPYTHON_INCLUDE_DIR=${PYTHON_INCLUDE_DIR}"
  "-DPYTHON_INCLUDE_CONFIG_DIR=${PYTHON_INCLUDE_CONFIG_DIR}"
  "-DPYTHON_NUMPY_PATH=${PYTHON_NUMPY_PATH}"
  "-DPYTHON_NUMPY_INCLUDE_DIRS=${PYTHON_NUMPY_INCLUDE_DIRS}"
  "-DWITH_INSTALL_PORTABLE=ON"
  "-DWITH_PYTHON_INSTALL=ON"
  "-DCMAKE_INSTALL_RPATH=${PYTHON_LIBPATH}"
  "-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
)

echo "Building Blender with Python ${PYTHON_VERSION} from ${PYTHON_ROOT_DIR}"

if command -v nvcc >/dev/null 2>&1; then
  cuda_arches="$(nvcc --list-gpu-code | awk 'NF {print $1}' | paste -sd';' -)"
  if [[ -n "${cuda_arches}" ]]; then
    if nvcc --list-gpu-arch | grep -q '^compute_75$'; then
      cuda_arches="${cuda_arches};compute_75"
    fi
    build_cmake_args+=("-DCYCLES_CUDA_BINARIES_ARCH=${cuda_arches}")
  fi
fi

if [[ -f CMakeCache.txt || -d CMakeFiles ]]; then
  echo "Removing accidental in-source CMake cache from $(pwd)"
  rm -rf CMakeCache.txt CMakeFiles
fi

install_release=false
package_deb=false
for target in "$@"; do
  case "${target}" in
    install)
      install_release=true
      ;;
    deb | package_deb)
      package_deb=true
      ;;
    *)
      echo "Unknown target: ${target}"
      echo "Usage: ./bld [install] [deb]"
      exit 2
      ;;
  esac
done

build_dir_base="${BUILD_DIR:-$(dirname "$(pwd -P)")/build_$(uname -s | tr '[:upper:]' '[:lower:]')}"
release_build_dir="${build_dir_base}_release"
bpy_build_dir="${build_dir_base}_bpy_release"
build_jobs="${NPROCS:-$(nproc)}"

echo "Configuring release build in ${release_build_dir}"
cmake \
  -C build_files/cmake/config/blender_release.cmake \
  -DWITH_COMPILER_CCACHE=YES \
  "${build_cmake_args[@]}" \
  -G Ninja \
  -S . \
  -B "${release_build_dir}"

echo "Building release"
cmake --build "${release_build_dir}" --parallel "${build_jobs}"

if [[ "${package_deb}" == true ]]; then
  cmake --build "${release_build_dir}" --parallel "${build_jobs}" --target package_deb
fi

if [[ "${install_release}" == true ]]; then
  echo "Installing release"
  cmake --install "${release_build_dir}"

  # Blender's NumPy install rule copies the package but not the companion
  # directory used by binary wheel builds for OpenBLAS and other shared libraries.
  if [[ -d "${PYTHON_NUMPY_LIBS}" ]]; then
    release_cmake_cache="${release_build_dir}/CMakeCache.txt"
    install_prefix="$(sed -n 's/^CMAKE_INSTALL_PREFIX:[^=]*=//p' "${release_cmake_cache}")"
    blender_version="$(
      awk '/^#define BLENDER_VERSION [0-9]+$/ {
        printf "%d.%d", int($3 / 100), $3 % 100
        exit
      }' source/blender/blenkernel/BKE_blender_version.h
    )"
    installed_site_packages="${install_prefix}/${blender_version}/python/lib/python${PYTHON_VERSION}/site-packages"
    cmake -E copy_directory "${PYTHON_NUMPY_LIBS}" "${installed_site_packages}/numpy.libs"
  fi
fi

# Build Blender again as a Python module in its own build directory, then package
# the installed `bpy` package as a versioned wheel for the active Conda Python.
bpy_cmake_args=()
for arg in "${build_cmake_args[@]}"; do
  if [[ "${arg}" == -DWITH_PYTHON_INSTALL=* ]]; then
    bpy_cmake_args+=("-DWITH_PYTHON_INSTALL=OFF")
  else
    bpy_cmake_args+=("${arg}")
  fi
done
echo "Configuring bpy build in ${bpy_build_dir}"
cmake \
  -C build_files/cmake/config/blender_release.cmake \
  -C build_files/cmake/config/bpy_module.cmake \
  -DWITH_COMPILER_CCACHE=YES \
  "${bpy_cmake_args[@]}" \
  -G Ninja \
  -S . \
  -B "${bpy_build_dir}"

echo "Building bpy module"
cmake --build "${bpy_build_dir}" --parallel "${build_jobs}"
cmake --install "${bpy_build_dir}"

bpy_cmake_cache="${bpy_build_dir}/CMakeCache.txt"
if [[ ! -f "${bpy_cmake_cache}" ]]; then
  echo "bpy CMake cache not found after build: ${bpy_cmake_cache}"
  exit 1
fi

bpy_install_dir="$(sed -n 's/^CMAKE_INSTALL_PREFIX:[^=]*=//p' "${bpy_cmake_cache}")"
wheel_output_dir="${bpy_build_dir}/wheel"
"${python_executable}" build_files/utils/make_bpy_wheel.py \
  "${bpy_install_dir}" \
  --build-dir="${bpy_build_dir}" \
  --output-dir="${wheel_output_dir}"

echo "bpy wheel written to ${wheel_output_dir}"
